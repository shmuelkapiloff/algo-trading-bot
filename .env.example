# AlgoTrader Pro — Environment Variables Template
# Copy to .env and fill in your values. Never commit .env to git.

# ── Database ──────────────────────────────────────────────────────────────────
# Dev (SQLite — no server needed):
DATABASE_URL=sqlite+aiosqlite:///trading.db
# Prod (PostgreSQL + TimescaleDB on AWS RDS):
# DATABASE_URL=postgresql+asyncpg://user:password@host:5432/algotrader

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Fencing Token Secret ──────────────────────────────────────────────────────
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
# Store in AWS Secrets Manager / Vault for production. Never hardcode.
FENCING_SECRET=

# ── Alpaca Markets ────────────────────────────────────────────────────────────
ALPACA_API_KEY=
ALPACA_SECRET=
# Paper trading (default). Switch to https://api.alpaca.markets for live.
ALPACA_BASE_URL=https://paper-api.alpaca.markets
ALPACA_DATA_URL=https://data.alpaca.markets

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO

# ── Telegram Alerts (optional) ────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
